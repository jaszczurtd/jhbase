cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/utf8proc_pin.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/git_dependency.cmake")
if(DEFINED JHBASE_UTF8PROC_DIR AND NOT JHBASE_UTF8PROC_DIR STREQUAL "")
  if(NOT IS_ABSOLUTE "${JHBASE_UTF8PROC_DIR}")
    message(FATAL_ERROR "JHBASE_UTF8PROC_DIR must be an absolute path")
  endif()
  set(jb_utf8proc_source "${JHBASE_UTF8PROC_DIR}")
else()
  get_filename_component(jb_utf8proc_source "${CMAKE_CURRENT_LIST_DIR}/../third_party/utf8proc" ABSOLUTE)
endif()
jb_check_git_dependency("${jb_utf8proc_source}" "${UTF8PROC_REPO}" "${UTF8PROC_REF}" jb_utf8proc_error)
if(NOT jb_utf8proc_error STREQUAL "")
  message(FATAL_ERROR "${jb_utf8proc_error}. Prepare the pinned checkout at this path; "
    "cmake -P scripts/ensure_utf8proc.cmake prepares only the default path")
endif()

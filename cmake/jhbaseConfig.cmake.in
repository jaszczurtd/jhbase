@PACKAGE_INIT@

# jhbase @PROJECT_VERSION@ built from @jb_revision@.
set(jhbase_REVISION "@jb_revision@")
set(jhbase_ABI_PROFILE "@jb_abi_profile@")

include("${CMAKE_CURRENT_LIST_DIR}/jhbaseStatusTargets.cmake")
# A package installed by a parent project (HAL) carries only jb::status.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/jhbaseTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/jhbaseTargets.cmake")
endif()
if(@JHBASE_UNICODE@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/jhbaseUnicodeTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/jhbaseUnicodeTargets.cmake")
endif()
if(@JHBASE_HOST@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/jhbaseFilesystemTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/jhbaseFilesystemTargets.cmake")
endif()
if(@JHBASE_HOST@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/jhbaseHostTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/jhbaseHostTargets.cmake")
endif()
if(@JHBASE_ARCHIVE@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/jhbaseArchiveTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/jhbaseArchiveTargets.cmake")
endif()
if(@JHBASE_DOWNLOAD@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/jhbaseDownloadTargets.cmake")
  if(NOT WIN32)
    # The installed static libcurl links the system OpenSSL and threads.
    include(CMakeFindDependencyMacro)
    find_dependency(OpenSSL)
    find_dependency(Threads)
    # A GCC build of libcurl repeats OpenSSL::Crypto through this target for the
    # static link order of GNU ld; curl's own package defines it the same way.
    if(TARGET OpenSSL::Crypto AND NOT TARGET CURL::OpenSSL_Crypto)
      add_library(CURL::OpenSSL_Crypto INTERFACE IMPORTED)
      set_target_properties(CURL::OpenSSL_Crypto PROPERTIES INTERFACE_LINK_LIBRARIES OpenSSL::Crypto)
    endif()
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/jhbaseDownloadTargets.cmake")
endif()
check_required_components(jhbase)

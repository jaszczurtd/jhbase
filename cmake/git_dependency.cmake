# Shared by preparation and read-only verification; no fetch during configure.
function(jb_check_git_dependency directory repository revision out_error)
  find_program(jb_git NAMES git REQUIRED)
  set(error "")
  if(NOT IS_DIRECTORY "${directory}/.git" OR IS_SYMLINK "${directory}")
    set(error "Managed checkout is missing: ${directory}")
  else()
    execute_process(COMMAND "${jb_git}" -C "${directory}" rev-parse HEAD
      RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT rc EQUAL 0 OR NOT actual STREQUAL revision)
      set(error "Wrong revision in ${directory}: expected ${revision}, got ${actual}")
    endif()
    if(error STREQUAL "")
      execute_process(COMMAND "${jb_git}" -C "${directory}" remote get-url origin
        RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(NOT rc EQUAL 0 OR NOT actual STREQUAL repository)
        set(error "Wrong origin in ${directory}: expected ${repository}, got ${actual}")
      endif()
    endif()
    if(error STREQUAL "")
      execute_process(COMMAND "${jb_git}" --no-optional-locks -c core.filemode=false -c core.autocrlf=false
        -C "${directory}" status --porcelain --untracked-files=all --ignored
        RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(NOT rc EQUAL 0 OR NOT actual STREQUAL "")
        set(error "Modified managed checkout: ${directory}: ${actual}")
      endif()
    endif()
    if(error STREQUAL "")
      # Check actual bytes too: index flags such as assume-unchanged can hide
      # local edits from status. No index refresh or source writes are needed.
      execute_process(COMMAND "${jb_git}" -C "${directory}" ls-tree -r HEAD
        RESULT_VARIABLE rc OUTPUT_VARIABLE tree OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      set(paths)
      set(expected)
      string(REPLACE "\n" ";" entries "${tree}")
      foreach(entry IN LISTS entries)
        if(NOT entry MATCHES "^[0-7]+ blob ([a-f0-9]+)\t(.+)$")
          set(error "Unsupported dependency tree entry: ${entry}")
          break()
        endif()
        list(APPEND expected "${CMAKE_MATCH_1}")
        list(APPEND paths "${CMAKE_MATCH_2}")
      endforeach()
      if(rc EQUAL 0 AND error STREQUAL "")
        execute_process(COMMAND "${jb_git}" -C "${directory}" hash-object --no-filters -- ${paths}
          RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        string(REPLACE "\n" ";" actual "${actual}")
        if(NOT rc EQUAL 0 OR NOT actual STREQUAL expected)
          set(error "Dependency source bytes differ from the pin: ${directory}")
        endif()
      elseif(error STREQUAL "")
        set(error "Cannot inspect dependency tree: ${directory}")
      endif()
    endif()
  endif()
  set(${out_error} "${error}" PARENT_SCOPE)
endfunction()

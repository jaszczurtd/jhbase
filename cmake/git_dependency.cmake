# Shared by preparation and read-only verification; no fetch during configure.
# EMPTY_SUBMODULES lists unused gitlinks that must remain empty directories.
# All other gitlinks remain unsupported; populated submodules are never skipped.
function(jb_check_git_dependency directory repository revision out_error)
  cmake_parse_arguments(PARSE_ARGV 4 arg "" "" "EMPTY_SUBMODULES")
  if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES)
    set(${out_error} "Invalid dependency verification arguments" PARENT_SCOPE)
    return()
  endif()
  find_program(jb_git NAMES git REQUIRED)
  set(error "")
  if(NOT IS_DIRECTORY "${directory}/.git" OR IS_SYMLINK "${directory}")
    set(error "Managed checkout is missing: ${directory}")
  else()
    execute_process(COMMAND "${jb_git}" -C "${directory}" rev-parse HEAD
      RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT rc EQUAL 0 OR NOT actual STREQUAL revision)
      set(error "Wrong revision in ${directory}: expected ${revision}, got ${actual}")
    endif()
    if(error STREQUAL "")
      execute_process(COMMAND "${jb_git}" -C "${directory}" remote get-url origin
        RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(NOT rc EQUAL 0 OR NOT actual STREQUAL repository)
        set(error "Wrong origin in ${directory}: expected ${repository}, got ${actual}")
      endif()
    endif()
    if(error STREQUAL "")
      execute_process(COMMAND "${jb_git}" --no-optional-locks -c core.filemode=false -c core.autocrlf=false
        -C "${directory}" status --porcelain --untracked-files=all --ignored
        RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(NOT rc EQUAL 0 OR NOT actual STREQUAL "")
        set(error "Modified managed checkout: ${directory}: ${actual}")
      endif()
    endif()
    if(error STREQUAL "")
      # Check actual bytes too: index flags such as assume-unchanged can hide
      # local edits from status. No index refresh or source writes are needed.
      execute_process(COMMAND "${jb_git}" -C "${directory}" ls-tree -r HEAD
        RESULT_VARIABLE rc OUTPUT_VARIABLE tree OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      set(paths)
      set(expected)
      string(REPLACE "\n" ";" entries "${tree}")
      foreach(entry IN LISTS entries)
        if(entry MATCHES "^160000 commit [a-f0-9]+\t(.+)$" AND
            CMAKE_MATCH_1 IN_LIST arg_EMPTY_SUBMODULES)
          set(unused "${directory}/${CMAKE_MATCH_1}")
          if(NOT IS_DIRECTORY "${unused}" OR IS_SYMLINK "${unused}")
            set(error "Unused submodule must be an empty directory: ${unused}")
            break()
          endif()
          file(GLOB contents LIST_DIRECTORIES TRUE "${unused}/*" "${unused}/.*")
          if(contents)
            set(error "Unused submodule contains files: ${unused}")
            break()
          endif()
          continue()
        endif()
        if(NOT entry MATCHES "^[0-7]+ blob ([a-f0-9]+)\t(.+)$")
          set(error "Unsupported dependency tree entry: ${entry}")
          break()
        endif()
        list(APPEND expected "${CMAKE_MATCH_1}")
        list(APPEND paths "${CMAKE_MATCH_2}")
      endforeach()
      if(rc EQUAL 0 AND error STREQUAL "")
        # Batches keep each command line well below the Windows limit of
        # 32767 characters; libarchive's file list alone exceeds it.
        set(actual)
        set(batch)
        set(batch_length 0)
        list(LENGTH paths remaining)
        foreach(path IN LISTS paths)
          list(APPEND batch "${path}")
          string(LENGTH "${path}" path_length)
          math(EXPR batch_length "${batch_length} + ${path_length} + 3")
          math(EXPR remaining "${remaining} - 1")
          if(batch_length GREATER 16000 OR remaining EQUAL 0)
            execute_process(COMMAND "${jb_git}" -C "${directory}" hash-object --no-filters -- ${batch}
              RESULT_VARIABLE rc OUTPUT_VARIABLE hashes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(NOT rc EQUAL 0)
              break()
            endif()
            string(REPLACE "\n" ";" hashes "${hashes}")
            list(APPEND actual ${hashes})
            set(batch)
            set(batch_length 0)
          endif()
        endforeach()
        if(NOT rc EQUAL 0 OR NOT actual STREQUAL expected)
          set(error "Dependency source bytes differ from the pin: ${directory}")
        endif()
      elseif(error STREQUAL "")
        set(error "Cannot inspect dependency tree: ${directory}")
      endif()
    endif()
  endif()
  set(${out_error} "${error}" PARENT_SCOPE)
endfunction()

# Read PREFIX_* keys of a pin file into the caller's scope. PREFIX_REPO must
# be an HTTPS .git URL, PREFIX_REF a full commit and PREFIX_VERSION a dotted
# release number; other keys are passed through for the caller to check.
function(jb_read_git_pin file prefix)
  file(STRINGS "${file}" lines)
  foreach(line IN LISTS lines)
    if(line MATCHES "^(${prefix}_[A-Z0-9_]+)=(.+)$")
      set("${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}")
      set("${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}" PARENT_SCOPE)
    endif()
  endforeach()
  string(LENGTH "${${prefix}_REF}" ref_length)
  if(NOT ref_length EQUAL 40 OR NOT "${${prefix}_REF}" MATCHES "^[a-f0-9]+$"
      OR NOT "${${prefix}_REPO}" MATCHES "^https://[^ ]+\\.git$"
      OR NOT "${${prefix}_VERSION}" MATCHES "^[0-9]+(\\.[0-9]+)+$")
    message(FATAL_ERROR "Invalid ${prefix} pin: ${file}")
  endif()
endfunction()

# Explicit preparation of one pinned checkout. A verified checkout is kept;
# otherwise the revision is fetched into a sibling staging directory under a
# lock, verified there and moved into place. JB_VERIFY_ONLY only checks.
function(jb_ensure_git_dependency label directory repository revision script)
  jb_check_git_dependency("${directory}" "${repository}" "${revision}" error)
  if(error STREQUAL "")
    message(STATUS "${label} ready: ${directory}")
    return()
  endif()
  if(JB_VERIFY_ONLY)
    message(FATAL_ERROR "${error}. Run cmake -P ${script}")
  endif()
  if(IS_SYMLINK "${directory}")
    message(FATAL_ERROR "Managed checkout must not be a symlink: ${directory}")
  endif()
  get_filename_component(name "${directory}" NAME)
  set(locks "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.build/locks")
  file(MAKE_DIRECTORY "${locks}")
  file(LOCK "${locks}/${name}.lock" GUARD FUNCTION TIMEOUT 60)
  jb_check_git_dependency("${directory}" "${repository}" "${revision}" error)
  if(error STREQUAL "")
    return()
  endif()
  set(staging "${directory}.staging")
  if(IS_SYMLINK "${staging}")
    message(FATAL_ERROR "Staging must not be a symlink: ${staging}")
  endif()
  file(REMOVE_RECURSE "${staging}")
  find_program(jb_git NAMES git REQUIRED)
  foreach(arguments IN ITEMS
      "init;-q;${staging}"
      "-C;${staging};config;core.autocrlf;false"
      "-C;${staging};remote;add;origin;${repository}"
      "-C;${staging};fetch;-q;--depth;1;origin;${revision}"
      "-C;${staging};checkout;-q;--detach;FETCH_HEAD")
    execute_process(COMMAND "${jb_git}" ${arguments} RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "git preparation failed: ${arguments}")
    endif()
  endforeach()
  jb_check_git_dependency("${staging}" "${repository}" "${revision}" error)
  if(NOT error STREQUAL "")
    message(FATAL_ERROR "${error}")
  endif()
  file(REMOVE_RECURSE "${directory}")
  file(RENAME "${staging}" "${directory}")
  message(STATUS "${label} prepared: ${directory}")
endfunction()

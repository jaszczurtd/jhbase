# SHA-256 check of a reviewed file, shared by the dependency and Ryu manifest
# checks so that each of them also runs on its own with cmake -P.
function(jb_check_hash path expected out_error)
  set(error "")
  if(IS_SYMLINK "${path}" OR IS_DIRECTORY "${path}")
    set(error "Expected a regular pinned file: ${path}")
  elseif(NOT EXISTS "${path}")
    set(error "Missing pinned file: ${path}")
  else()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
      set(error "Pinned file has a different SHA-256: ${path}")
    endif()
  endif()
  set("${out_error}" "${error}" PARENT_SCOPE)
endfunction()

function(jb_require_hash path expected)
  jb_check_hash("${path}" "${expected}" error)
  if(NOT error STREQUAL "")
    message(FATAL_ERROR "${error}")
  endif()
endfunction()

# Each shipped upstream file is checked before configuration or staging.
function(jb_require_manifest root count)
  file(STRINGS "${root}/SHA256SUMS" entries)
  list(LENGTH entries actual_count)
  if(NOT actual_count EQUAL count)
    message(FATAL_ERROR "Incomplete source/license manifest: ${root}")
  endif()
  foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^([0-9a-f]+)  (.+)$")
      message(FATAL_ERROR "Invalid hash manifest entry: ${root}")
    endif()
    jb_require_hash("${root}/${CMAKE_MATCH_2}" "${CMAKE_MATCH_1}")
  endforeach()
endfunction()

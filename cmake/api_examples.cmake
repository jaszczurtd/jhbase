function(jb_extract_api_examples language)
  set(path "${CMAKE_CURRENT_SOURCE_DIR}/doc/${language}/api.md")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  file(READ "${path}" remaining)
  set(output "/* Generated from the complete API examples; edit the Markdown. */\n")
  set(count 0)
  while(TRUE)
    string(FIND "${remaining}" "```c\n#include" start)
    if(start EQUAL -1)
      break()
    endif()
    math(EXPR start "${start} + 5")
    string(SUBSTRING "${remaining}" ${start} -1 remaining)
    string(FIND "${remaining}" "\n```" end)
    if(end EQUAL -1)
      message(FATAL_ERROR "Unclosed API example: ${path}")
    endif()
    string(SUBSTRING "${remaining}" 0 ${end} block)
    string(APPEND output "${block}\n\n")
    math(EXPR next "${end} + 4")
    string(SUBSTRING "${remaining}" ${next} -1 remaining)
    math(EXPR count "${count} + 1")
  endwhile()
  if(NOT count EQUAL 9)
    message(FATAL_ERROR "Update the API example driver for ${count} complete examples")
  endif()
  set(jb_doc_include "${CMAKE_CURRENT_BINARY_DIR}/api-examples/${language}.inc")
  file(WRITE "${jb_doc_include}" "${output}")
  foreach(extension c cpp)
    if(extension STREQUAL "c")
      set(driver "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_api_examples.c")
    else()
      set(driver "${CMAKE_CURRENT_BINARY_DIR}/api-examples/driver.cpp")
      configure_file(tests/test_api_examples.c "${driver}" COPYONLY)
    endif()
    set(target test_api_${language}_${extension})
    add_executable(${target} "${driver}")
    target_link_libraries(${target} PRIVATE jb::base unity)
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/tests")
    target_compile_definitions(${target} PRIVATE JB_DOC_EXAMPLES="${jb_doc_include}")
    jb_warnings(${target})
    add_test(NAME api_${language}_${extension} COMMAND ${target})
    set_tests_properties(api_${language}_${extension} PROPERTIES TIMEOUT 30 LABELS "basic")
  endforeach()
endfunction()
jb_extract_api_examples(en)
jb_extract_api_examples(pl)
file(SHA256 "${CMAKE_CURRENT_BINARY_DIR}/api-examples/en.inc" jb_en_examples)
file(SHA256 "${CMAKE_CURRENT_BINARY_DIR}/api-examples/pl.inc" jb_pl_examples)
if(NOT jb_en_examples STREQUAL jb_pl_examples)
  message(FATAL_ERROR "English and Polish API examples differ")
endif()

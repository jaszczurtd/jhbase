# Explicit preparation on Linux and Windows; configure only verifies.
# cmake [-DJB_VERIFY_ONLY=ON] -P scripts/ensure_unicode_test.cmake
cmake_minimum_required(VERSION 3.22)
get_filename_component(jb_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${jb_root}/cmake/unicode_fixture.cmake")
set(jb_source "${jb_root}/tests/fixtures/unicode")
jb_check_unicode_fixture("${jb_source}" error)
if(error STREQUAL "")
  message(STATUS "Unicode ${UTF8PROC_UNICODE_VERSION} conformance data ready: ${jb_source}")
  return()
endif()
if(JB_VERIFY_ONLY)
  message(FATAL_ERROR "${error}. Run cmake -P ${CMAKE_CURRENT_LIST_FILE}")
endif()
if(IS_SYMLINK "${jb_source}")
  message(FATAL_ERROR "Managed test directory must not be a symlink: ${jb_source}")
endif()
file(MAKE_DIRECTORY "${jb_root}/.build/locks")
file(LOCK "${jb_root}/.build/locks/unicode-test.lock" GUARD PROCESS TIMEOUT 60)
jb_check_unicode_fixture("${jb_source}" error)
if(error STREQUAL "")
  return()
endif()
set(jb_staging "${jb_source}.staging")
if(IS_SYMLINK "${jb_staging}")
  message(FATAL_ERROR "Staging must not be a symlink: ${jb_staging}")
endif()
file(REMOVE_RECURSE "${jb_staging}")
file(MAKE_DIRECTORY "${jb_staging}")
find_program(jb_curl NAMES curl.exe curl REQUIRED)
foreach(component IN ITEMS NORMALIZATION LICENSE)
  execute_process(COMMAND "${jb_curl}" --disable --fail --location --silent --show-error
    --proto =https --proto-redir =https --tlsv1.2 --connect-timeout 20 --max-time 120 --retry 2
    --output "${jb_staging}/${UNICODE_TEST_${component}_FILE}" "${UNICODE_TEST_${component}_URL}"
    RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Unicode test download failed: ${component}")
  endif()
endforeach()
jb_check_unicode_fixture("${jb_staging}" error)
if(NOT error STREQUAL "")
  message(FATAL_ERROR "${error}")
endif()
file(REMOVE_RECURSE "${jb_source}")
file(RENAME "${jb_staging}" "${jb_source}")
message(STATUS "Unicode ${UTF8PROC_UNICODE_VERSION} conformance data prepared: ${jb_source}")

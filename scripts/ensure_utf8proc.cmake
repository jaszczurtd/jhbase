# Explicit preparation on Linux and Windows; configure only verifies.
# cmake [-DJB_VERIFY_ONLY=ON] -P scripts/ensure_utf8proc.cmake
cmake_minimum_required(VERSION 3.22)
get_filename_component(jb_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${jb_root}/cmake/utf8proc_pin.cmake")
include("${jb_root}/cmake/git_dependency.cmake")
set(jb_source "${jb_root}/third_party/utf8proc")
jb_check_git_dependency("${jb_source}" "${UTF8PROC_REPO}" "${UTF8PROC_REF}" error)
if(error STREQUAL "")
  message(STATUS "utf8proc ${UTF8PROC_VERSION} ready: ${jb_source}")
  return()
endif()
if(JB_VERIFY_ONLY)
  message(FATAL_ERROR "${error}. Run cmake -P ${CMAKE_CURRENT_LIST_FILE}")
endif()
if(IS_SYMLINK "${jb_source}")
  message(FATAL_ERROR "Managed checkout must not be a symlink: ${jb_source}")
endif()
file(MAKE_DIRECTORY "${jb_root}/.build/locks")
file(LOCK "${jb_root}/.build/locks/utf8proc.lock" GUARD PROCESS TIMEOUT 60)
jb_check_git_dependency("${jb_source}" "${UTF8PROC_REPO}" "${UTF8PROC_REF}" error)
if(error STREQUAL "")
  return()
endif()
set(jb_staging "${jb_source}.staging")
if(IS_SYMLINK "${jb_staging}")
  message(FATAL_ERROR "Staging must not be a symlink: ${jb_staging}")
endif()
file(REMOVE_RECURSE "${jb_staging}")
find_program(jb_git NAMES git REQUIRED)
function(run)
  execute_process(COMMAND "${jb_git}" ${ARGN} RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "git preparation failed: ${ARGN}")
  endif()
endfunction()
run(init -q "${jb_staging}")
run(-C "${jb_staging}" config core.autocrlf false)
run(-C "${jb_staging}" remote add origin "${UTF8PROC_REPO}")
run(-C "${jb_staging}" fetch -q --depth 1 origin "${UTF8PROC_REF}")
run(-C "${jb_staging}" checkout -q --detach FETCH_HEAD)
jb_check_git_dependency("${jb_staging}" "${UTF8PROC_REPO}" "${UTF8PROC_REF}" error)
if(NOT error STREQUAL "")
  message(FATAL_ERROR "${error}")
endif()
file(REMOVE_RECURSE "${jb_source}")
file(RENAME "${jb_staging}" "${jb_source}")
message(STATUS "utf8proc ${UTF8PROC_VERSION} prepared: ${jb_source}")
